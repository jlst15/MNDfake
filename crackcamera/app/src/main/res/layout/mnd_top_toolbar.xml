<?xml version="1.0" encoding="utf-8"?>
<!-- Top row aligned with originalSource/layout-xhdpi/drawer_base.xml Toolbar:
     padding 10dip, ivMenu layout_marginLeft 15dip. RelativeLayout avoids AppCompat Toolbar min-height (~56dp). -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/toolbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:padding="10.0dip">

    <ImageButton
        android:id="@+id/ivMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginLeft="15.0dip"
        android:background="@drawable/img_common_drawer_menu"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/mnfake_toolbar_menu" />

    <ImageView
        android:id="@+id/ivUserState"
        android:layout_width="@dimen/mnd_toolbar_logo_width"
        android:layout_height="@dimen/mnd_toolbar_logo_height"
        android:layout_centerInParent="true"
        android:background="@drawable/img_common_mnsa_logo"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@null" />

    <ImageButton
        android:id="@+id/btnDeleteApp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="@drawable/img_common_drawer_delete"
        android:contentDescription="@string/common___delete"
        android:padding="5.0dip"
        android:layout_marginEnd="10.0dip" />
</RelativeLayout>
