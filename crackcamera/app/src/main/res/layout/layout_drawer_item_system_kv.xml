<?xml version="1.0" encoding="utf-8"?>
<!-- 시스템 정보 rows: small checkmark (original APK img_ico_check), label, value right -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="15.0dip"
    android:paddingTop="12.0dip"
    android:paddingRight="15.0dip"
    android:paddingBottom="12.0dip"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/ivKvIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_marginRight="10.0dip"
        android:contentDescription="@null"
        android:background="@drawable/img_ico_check" />

    <TextView
        android:id="@+id/tvKvTitle"
        android:textSize="18.0sp"
        android:textStyle="bold"
        android:textColor="@drawable/style_common_drawer_item_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toRightOf="@id/ivKvIcon"
        android:layout_toLeftOf="@+id/tvKvValue"
        android:layout_marginRight="8.0dip" />

    <TextView
        android:id="@+id/tvKvValue"
        android:textSize="16.0sp"
        android:textStyle="normal"
        android:textColor="@color/common_base_color_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:gravity="end"
        android:maxLines="3"
        android:ellipsize="end" />
</RelativeLayout>
