<?xml version="1.0" encoding="utf-8"?>
<!-- Compact bottom sheet: dark rounded card (confirm before camera toggle). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="56dp"
    android:paddingRight="56dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:id="@+id/sheetCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/mnfake_dialog_sheet_dark_bg"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="18dp"
        android:paddingRight="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tvConfirmTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/common_txt_write"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvConfirmMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/common_txt_write"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnConfirmCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/mnfake_dialog_confirm_btn_bg"
                android:minHeight="48dp"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:text="@string/mnfake_dialog_cancel"
                android:textAllCaps="false"
                android:textColor="@color/common_txt_write"
                android:textSize="15sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:background="#33ffffff" />

            <Button
                android:id="@+id/btnConfirmOk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/mnfake_dialog_confirm_btn_bg"
                android:minHeight="48dp"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:text="@string/mnfake_dialog_confirm"
                android:textAllCaps="false"
                android:textColor="@color/common_txt_write"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
