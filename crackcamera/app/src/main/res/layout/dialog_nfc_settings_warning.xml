<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom sheet when NFC is off; strings match originalSource (mndmdm_common_popup_nfc_off_*). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="24dp">

    <LinearLayout
        android:id="@+id/nfcSheetCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/mnfake_dialog_sheet_dark_bg"
        android:orientation="vertical"
        android:paddingLeft="28dp"
        android:paddingTop="20dp"
        android:paddingRight="28dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/tvNfcTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mndmdm_common_popup_nfc_off_title"
            android:textColor="@color/common_txt_write"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNfcBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/mndmdm_common_popup_nfc_off_desc"
            android:textColor="@color/common_txt_write"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnNfcDismiss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/mnfake_dialog_confirm_btn_bg"
            android:gravity="center"
            android:minHeight="40dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="@string/mnfake_dialog_confirm"
            android:textAllCaps="false"
            android:textColor="@color/common_txt_write"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
