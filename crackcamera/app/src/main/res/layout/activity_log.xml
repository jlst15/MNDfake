<?xml version="1.0" encoding="utf-8"?>
<!-- Names aligned with originalSource public.xml: activity_log, lvLog -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mnfake_log_content"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/mnfake_log_top_bar"
        android:paddingStart="4dip"
        android:paddingTop="2dip"
        android:paddingEnd="4dip"
        android:paddingBottom="13dip">

        <ImageButton
            android:id="@+id/btnLogBack"
            android:layout_width="47dip"
            android:layout_height="47dip"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="2dip"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mnfake_log_back"
            android:padding="6dip"
            android:scaleType="fitCenter"
            android:src="@drawable/abc_ic_ab_back_material" />

        <TextView
            android:id="@+id/tvLogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:paddingStart="8dip"
            android:paddingTop="6dip"
            android:paddingEnd="8dip"
            android:paddingBottom="6dip"
            android:text="@string/drawer_menu_log"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <TextView
        android:id="@+id/tvLogEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dip"
        android:text="@string/mnfake_log_empty"
        android:textColor="@color/common_base_color_txt_gray"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lvLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/mnfake_log_content"
        android:cacheColorHint="@android:color/transparent"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="10dip"
        android:paddingStart="5dip"
        android:paddingEnd="5dip"
        android:paddingBottom="10dip" />

    <EditText
        android:id="@+id/etLogEditor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/mnfake_log_content"
        android:gravity="top|start"
        android:hint="@string/mnfake_log_edit_hint"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textNoSuggestions"
        android:padding="12dip"
        android:scrollbars="vertical"
        android:textColor="@android:color/white"
        android:textColorHint="@color/common_base_color_txt_gray"
        android:textSize="14sp"
        android:typeface="monospace"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dip"
        android:layout_marginTop="8dip"
        android:layout_marginEnd="16dip"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnLogEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/mnfake_btn_pill_grey"
            android:minHeight="44dip"
            android:text="@string/mnfake_log_edit"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnLogSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dip"
            android:layout_weight="1"
            android:background="@drawable/mnfake_btn_pill_grey"
            android:minHeight="44dip"
            android:text="@string/mnfake_log_save"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnLogCancelEdit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dip"
            android:layout_weight="1"
            android:background="@drawable/mnfake_btn_pill_grey"
            android:minHeight="44dip"
            android:text="@string/mnfake_dialog_cancel"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>

    <Button
        android:id="@+id/btnLogClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dip"
        android:layout_marginTop="8dip"
        android:layout_marginEnd="16dip"
        android:layout_marginBottom="16dip"
        android:background="@drawable/mnfake_btn_log_close"
        android:minHeight="48dip"
        android:text="@string/common___close"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>
