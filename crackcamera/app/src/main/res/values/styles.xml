<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->

        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- LogActivity: window/body = dark grey; status bar = black to align with top strip -->
    <style name="AppTheme.LogScreen" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/mnfake_log_content</item>
        <item name="android:colorBackground">@color/mnfake_log_content</item>
        <item name="colorPrimaryDark">@color/mnfake_log_top_bar</item>
        <item name="android:statusBarColor">@color/mnfake_log_top_bar</item>
        <item name="android:navigationBarColor">@color/mnfake_log_content</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar"/>

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light"/>

    <!-- originalSource/res/values/styles.xml (fragment_n_rnd_mdm_main) -->
    <style name="TopTextContentsMid">
        <item name="android:textSize">20.0dip</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/common_base_color_txt</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="TopTextTitle">
        <item name="android:textSize">22.0dip</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/common_base_color_txt</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- fragment 레퍼: TopTextTitle 22dip + Mid 20dip. 설치/차단 두 줄 같은 크기로 노출용. -->
    <style name="TopTextInstallDateTitle">
        <item name="android:textSize">26.0dip</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/common_base_color_txt</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="TopTextInstallDateValue">
        <item name="android:textSize">24.0dip</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/common_base_color_txt</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
    </style>

</resources>
